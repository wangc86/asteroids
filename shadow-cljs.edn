{:source-paths ["src" "test"]

 :dependencies []

 :dev-http {8080 "public"}

 :builds
 {:app  {:target     :browser
         :output-dir "public/js"
         :asset-path "js"
         :modules    {:main {:init-fn asteroids.core/init!}}
         :devtools   {:after-load asteroids.core/after-load!}}

  ;; Unit tests for the pure logic, run under node without a browser: npm test
  :test {:target    :node-test
         :output-to "out/node-tests.js"
         :ns-regexp "-test$"
         :autorun   true}}}
